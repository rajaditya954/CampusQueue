rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymousUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (hasUserDoc() && (getUserRole() == "admin" || getUserRole() == "ADMIN"))
        || (request.auth.token.email != null && (
            request.auth.token.email == "admin@campusqueue.demo" ||
            request.auth.token.email.matches(".*admin.*@.*")
          ))
      );
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        (hasUserDoc() && (
          getUserRole() == "staff" || getUserRole() == "STAFF" ||
          getUserRole() == "admin" || getUserRole() == "ADMIN"
        ))
        || (!isAnonymousUser() && request.auth.token.email != null)
      );
    }

    // ─── Services ────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrAdmin();
    }

    // ─── Students Roster ────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrAdmin();
    }

    // ─── User Profiles ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffOrAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isStaffOrAdmin());
      allow delete: if isAdmin();
    }

    // ─── Counters ────────────────────────────────────────────────────────
    match /counters/{counterId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isStaffOrAdmin();
    }

    // ─── Global Configuration ───────────────────────────────────────────
    match /config/{configId} {
      allow read: if true;
      allow create, update: if configId == 'tokenCounters' || isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── Queue Entries ───────────────────────────────────────────────────
    match /queueEntries/{entryId} {
      allow read: if true;

      // Allow authenticated students to create their own queue entry with initial status 'waiting'
      allow create: if isAuthenticated()
        && request.resource.data.status == 'waiting'
        && request.resource.data.studentUid == request.auth.uid;

      // Staff/Admin can update or delete queue entries (call next, complete, skip, etc.)
      // Students can also update/cancel their own queue entry
      allow update, delete: if isStaffOrAdmin()
        || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
    }

    // ─── Service History ─────────────────────────────────────────────────
    match /serviceHistory/{historyId} {
      allow read: if true;
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Default Deny ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

