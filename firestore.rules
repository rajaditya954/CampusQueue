rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isStaff() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }

    function isStaffOrAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
    }

    // ─── Services ────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrAdmin();
    }

    // ─── Students Roster ────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── User Profiles ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffOrAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ─── Counters ────────────────────────────────────────────────────────
    match /counters/{counterId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isStaffOrAdmin();
    }

    // ─── Global Configuration ───────────────────────────────────────────
    match /config/{configId} {
      allow read: if true;
      // Allow token sequence counter increments for student token generation
      allow create, update: if configId == 'tokenCounters' || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Queue Entries ───────────────────────────────────────────────────
    match /queueEntries/{entryId} {
      allow read: if true;

      // Allow authenticated students to create their own queue entry with initial status 'waiting'
      allow create: if isAuthenticated()
        && request.resource.data.status == 'waiting'
        && request.resource.data.studentUid == request.auth.uid;

      // Allow authenticated sessions to update status (call next, start service, complete, etc.) or remove entries
      allow update, delete: if isAuthenticated();
    }

    // ─── Service History ─────────────────────────────────────────────────
    match /serviceHistory/{historyId} {
      allow read: if true;
      allow create: if isStaffOrAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Default Deny ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
